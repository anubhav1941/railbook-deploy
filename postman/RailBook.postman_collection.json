        {
          "name": "Create booking - 2 passengers 3A (CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{booking_url}}/bookings",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"user-101\",\n  \"train_no\": \"12952\",\n  \"journey_date\": \"{{journey_date}}\",\n  \"travel_class\": \"3A\",\n  \"passengers\": [\n    {\n      \"name\": \"Anubhav Arora\",\n      \"age\": 25,\n      \"gender\": \"M\"\n    },\n    {\n      \"name\": \"Rahul Sharma\",\n      \"age\": 28,\n      \"gender\": \"M\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));",
                  "const b = pm.response.json();",
                  "pm.test(\"Booking confirmed\", () => pm.expect(b.status).to.eql(\"CONFIRMED\"));",
                  "pm.collectionVariables.set(\"pnr\", b.pnr);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get PNR status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{booking_url}}/bookings/{{pnr}}",
