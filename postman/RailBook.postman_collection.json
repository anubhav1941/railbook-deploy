              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search trains NDLS to MMCT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventory_url}}/trains/search?source=NDLS&destination=MMCT&journey_date={{journey_date}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Seat availability 12952 / 3A",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventory_url}}/availability?train_no=12952&journey_date={{journey_date}}&travel_class=3A",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add train (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{inventory_url}}/trains",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"train_no\": \"22436\",\n  \"name\": \"Vande Bharat Express\",\n  \"source\": \"NDLS\",\n  \"destination\": \"BSB\",\n  \"departure_time\": \"06:00\",\n  \"arrival_time\": \"14:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created or already exists\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add schedule for new train (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{inventory_url}}/trains/22436/schedules",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journey_date\": \"{{journey_date}}\",\n  \"travel_class\": \"CC\",\n  \"total_seats\": 50,\n  \"fare\": 1750\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created or already exists\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
