            "url": "{{booking_url}}/bookings",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"user-101\",\n  \"train_no\": \"12952\",\n  \"journey_date\": \"{{journey_date}}\",\n  \"travel_class\": \"3A\",\n  \"passengers\": [\n    {\n      \"name\": \"Anubhav Arora\",\n      \"age\": 25,\n      \"gender\": \"M\"\n    },\n    {\n      \"name\": \"Rahul Sharma\",\n      \"age\": 28,\n      \"gender\": \"M\"\n    }\n  ],\n  \"simulate_payment_failure\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 402\", () => pm.response.to.have.status(402));",
