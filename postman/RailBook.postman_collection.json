{
  "info": {
    "name": "RailBook Microservices - 2025MT03101",
    "description": "Calls for inventory-service and booking-service. Run in order (Collection Runner works). journey_date is set automatically to today + 5 days.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('journey_date')) {",
          "  const d = new Date(); d.setDate(d.getDate() + 5);",
          "  pm.collectionVariables.set('journey_date', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "inventory_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "booking_url",
      "value": "http://localhost:8002"
    },
    {
      "key": "journey_date",
      "value": ""
    },
    {
      "key": "pnr",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Inventory Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventory_url}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness (DB check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventory_url}}/ready",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Served by pod:\", pm.response.headers.get(\"X-Served-By\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List trains",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventory_url}}/trains",
